# ==========================================================================
# MagicFT — Variables de entorno (copia este archivo a .env.local)
# La app CORRE SIN NINGUNA de estas llaves usando datos mock (USE_MOCK=true).
# Ve agregando llaves reales conforme integras cada proveedor.
# ==========================================================================

# Modo mock: si es true, la app usa datos de ejemplo y no llama a APIs de pago.
USE_MOCK=true

# --- Supabase (base de datos + auth) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- APIs deportivas (ver docs/02-apis-deportivas.md) ---
# API-Football (api-sports.io) — partidos, equipos, jugadores, lesiones, alineaciones
API_FOOTBALL_KEY=
# The Odds API — momios/cuotas
ODDS_API_KEY=

# --- IA (explicaciones en lenguaje natural) ---
# Recomendado: Claude (Anthropic). El modelo por defecto es claude-sonnet-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Stripe (pagos / suscripciones) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
